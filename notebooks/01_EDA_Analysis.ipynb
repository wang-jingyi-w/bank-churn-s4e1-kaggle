import sys
# 向上一级目录，加载src模块
sys.path.append("../")

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import warnings
warnings.filterwarnings("ignore")

# 全局绘图设置
plt.rcParams['font.sans-serif'] = ['SimHei']
plt.rcParams['axes.unicode_minus'] = False
sns.set_style("whitegrid")

from src.data.make_dataset import load_raw_data, clean_data

df_raw = load_raw_data("../data/raw/Churn_Modelling.csv")
df = clean_data(df_raw)

print(f"数据集大小：{df.shape}")
print("\n基础信息：")
print(df.info())
print("\n缺失值统计：")
print(df.isnull().sum())

# 目标变量分布
print("\n客户流失标签占比：")
print(df["Exited"].value_counts(normalize=True).round(3))

# 分类特征：Geography、Gender
cat_cols = ["Geography", "Gender"]
fig, axes = plt.subplots(1,2, figsize=(14,5))
for idx, col in enumerate(cat_cols):
    sns.countplot(data=df, x=col, hue="Exited", ax=axes[idx])
    axes[idx].set_title(f"{col} vs Customer Churn")
plt.tight_layout()
plt.savefig("../reports/figures/categorical_dist.png", dpi=300, bbox_inches="tight")
plt.show()

binary_cols = ["HasCrCard", "IsActiveMember"]
fig, axes = plt.subplots(1,2, figsize=(12,5))
for idx, col in enumerate(binary_cols):
    sns.countplot(data=df, x=col, hue="Exited", ax=axes[idx])
    axes[idx].set_title(f"{col} Churn Distribution")
plt.tight_layout()
plt.savefig("../reports/figures/binary_feature_churn.png", dpi=300)
plt.show()

# 计算各组流失率（业务重点，面试高频）
for col in binary_cols:
    print(f"\n==== {col} 分组流失率 ====")
    print(df.groupby(col)["Exited"].mean().round(3))

num_cols = ["CreditScore","Age","Tenure","Balance","NumOfProducts","EstimatedSalary"]
fig, axes = plt.subplots(2,3, figsize=(16,10))
axes = axes.flatten()
for idx, col in enumerate(num_cols):
    sns.boxplot(data=df, x="Exited", y=col, ax=axes[idx])
    axes[idx].set_title(f"{col} Boxplot Group by Churn")
plt.tight_layout()
plt.savefig("../reports/figures/numeric_boxplot.png", dpi=300)
plt.show()

corr = df.corr(numeric_only=True)
plt.figure(figsize=(10,8))
sns.heatmap(corr, annot=True, cmap="coolwarm", fmt=".2f")
plt.title("Feature Correlation Heatmap")
plt.savefig("../reports/figures/correlation_heatmap.png", dpi=300)
plt.show()