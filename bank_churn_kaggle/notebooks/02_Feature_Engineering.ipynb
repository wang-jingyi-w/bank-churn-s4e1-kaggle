import sys
# 向上一级目录，加载src模块
sys.path.append("../")

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import warnings
warnings.filterwarnings("ignore")

# 全局绘图设置
plt.rcParams['font.sans-serif'] = ['SimHei']
plt.rcParams['axes.unicode_minus'] = False
sns.set_style("whitegrid")

from src.data.make_dataset import load_raw_data, clean_data, split_dataset
df_raw = load_raw_data("../data/raw/Churn_Modelling.csv")
df = clean_data(df_raw)

# 分层抽样，防止标签分布偏移
X_train, X_test, y_train, y_test = split_dataset(df, test_size=0.2, random_state=42)

print(f"Train set: {X_train.shape}, Test set:{X_test.shape}")
print("训练集流失比例：", y_train.mean().round(3))
print("测试集流失比例：", y_test.mean().round(3))

def create_derived_features(df):
    df = df.copy()
    # 1. 余额是否为0
    df["ZeroBalance"] = (df["Balance"] == 0).astype(int)
    # 2. 年龄与持有产品数量交互特征
    df["Age_Product"] = df["Age"] * df["NumOfProducts"]
    # 3. 薪资余额比值
    df["Salary_Balance_Ratio"] = df["Balance"] / (df["EstimatedSalary"] + 1e-6)
    return df

X_train_feat = create_derived_features(X_train)
X_test_feat = create_derived_features(X_test)

from category_encoders import TargetEncoder

target_encoder = TargetEncoder()
cat_features = ["Geography", "Gender"]

# 仅用训练集拟合，避免数据泄漏！重点！
X_train_feat[cat_features] = target_encoder.fit_transform(X_train_feat[cat_features], y_train)
X_test_feat[cat_features] = target_encoder.transform(X_test_feat[cat_features])

# 存入processed文件夹
X_train_feat.to_csv("../data/processed/train_features.csv", index=False)
X_test_feat.to_csv("../data/processed/test_features.csv", index=False)
y_train.to_csv("../data/processed/train_target.csv", index=False)
y_test.to_csv("../data/processed/test_target.csv", index=False)